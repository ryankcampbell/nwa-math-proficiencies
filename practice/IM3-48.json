   },
   "stem": "What is the <b>amplitude</b> of this sinusoid?",
   "graph": {
    "window": [
     0,
     12,
     -8,
     8
    ],
    "fns": [
     {
      "f": "a*sin(2*pi*x/p)+d"
     }
    ]
   },
   "answer": "a",
   "tol": 0.01,
   "explain": "Max $=[[d+a]]$, min $=[[d-a]]$. $$\\text{amplitude}=\\frac{\\max-\\min}{2}=\\frac{[[d+a]]-([[d-a]])}{2}=[[a]]$$"
  },
